{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"a11y": { "noSvgWithoutTitle": "off" }
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.next",
			"!!**/dist",
			"!!**/build",
			"!!**/*.log",
			"!!**/*.tsbuildinfo",
			"!!**/playwright-report",
			"!!**/test-results"
		]
	},
	"assist": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": { "noStaticOnlyClass": "off" },
			"correctness": { "noComponentHookFactories": "off" },
			"suspicious": { "noUnknownAtRules": "off" },
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	}
}
