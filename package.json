{
	"name": "groupify",
	"version": "1.1.0",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "DB_URL=\"\" next build",
		"build:ci": "./scripts/ci.sh",
		"start": "next start",
		"lint": "biome check src",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:w": "vitest watch",
		"seed:e2e": "tsx e2e/seed.ts",
		"test:e2e": "npm run seed:e2e && npm run playwright",
		"playwright": "playwright test",
		"generate": "drizzle-kit generate:sqlite --schema=src/adapter/db/schema.ts",
		"migrate:preview": "drizzle-kit migrate --config=drizzle-preview.config.ts",
		"update-meta": "drizzle-kit up:sqlite",
		"studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@effect/opentelemetry": "^4.0.6",
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "16.4.3",
		"@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"@opentelemetry/sdk-trace-web": "^2.12.0",
		"@radix-ui/react-avatar": "1.3.1",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-toast": "^1.3.1",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"copy-text-to-clipboard": "^3.2.2",
		"drizzle-orm": "^0.45.4",
		"effect": "^4.0.6",
		"lucide-react": "^1.61.0",
		"nanoid": "^6.0.2",
		"next": "16.4.3",
		"next-themes": "^0.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/better-sqlite3": "^9.6.0",
		"@types/mdx": "^2.0.14",
		"@types/node": "^25.3.0",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
